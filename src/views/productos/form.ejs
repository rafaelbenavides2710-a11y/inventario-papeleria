<% const editando = producto && producto._id; %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <h1 class="h3 mb-3"><%= editando ? 'Editar producto' : 'Nuevo producto' %></h1>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="<%= formAction %>" method="POST" class="card card-body shadow-sm">
      <div class="mb-3">
        <label for="nombre" class="form-label">Nombre</label>
        <input type="text" class="form-control" id="nombre" name="nombre" required maxlength="200" value="<%= producto && producto.nombre ? producto.nombre : '' %>">
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="precio" class="form-label">Precio</label>
          <input type="number" class="form-control" id="precio" name="precio" required min="0" step="0.01" value="<%= producto && producto.precio !== undefined ? producto.precio : '' %>">
        </div>
        <div class="col-md-6 mb-3">
          <label for="stock" class="form-label">Stock</label>
          <input type="number" class="form-control" id="stock" name="stock" required min="0" step="1" value="<%= producto && producto.stock !== undefined ? producto.stock : 0 %>">
        </div>
      </div>

      <div class="mb-3">
        <label for="categoriaId" class="form-label">Categoría</label>
        <select class="form-select" id="categoriaId" name="categoriaId" required>
          <option value="">Selecciona una categoría</option>
          <% categorias.forEach((categoria) => { %>
            <option value="<%= categoria._id %>" <%= producto && producto.categoriaId && String(producto.categoriaId) === String(categoria._id) ? 'selected' : '' %>><%= categoria.nombre %></option>
          <% }); %>
        </select>
        <% if (!categorias.length) { %>
          <div class="form-text">No hay categorías. <a href="/categorias">Crea una primero</a>.</div>
        <% } %>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><%= editando ? 'Guardar cambios' : 'Crear producto' %></button>
        <a href="/productos" class="btn btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>
