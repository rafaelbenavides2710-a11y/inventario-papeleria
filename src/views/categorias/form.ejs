<div class="row justify-content-center">
  <div class="col-lg-6">
    <h1 class="h3 mb-3">Editar categoría</h1>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/categorias/<%= categoria._id %>" method="POST" class="card card-body shadow-sm">
      <div class="mb-3">
        <label for="nombre" class="form-label">Nombre</label>
        <input type="text" class="form-control" id="nombre" name="nombre" required maxlength="100" value="<%= categoria.nombre %>">
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a href="/categorias" class="btn btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>
